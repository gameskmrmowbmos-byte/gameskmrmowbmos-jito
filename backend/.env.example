NODE_ENV=development
PORT=5002
MONGODB_URI=mongodb://127.0.0.1:27017/matka_management
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!
DEMO_OPERATOR_PASSWORD=ChangeDemoPassword123!

FRONTEND_URL=http://localhost:5173
RESET_PASSWORD_URL=http://localhost:5173/reset-password
LOG_LEVEL=info
SHOW_DEV_OTP=true
OTP_EXPIRY_MINUTES=5
FREE_TRIAL_DAYS=10

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Matka Management Demo <no-reply@example.com>
